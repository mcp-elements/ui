{
  "name": "@mcp-elements/react",
  "version": "0.1.5",
  "description": "React UI primitives for building MCP hosts \u2014 tool-call cards, OAuth consent, scope inspector, JSON-Schema tool-forms, and an MCP Apps (SEP-1865) renderer, plus 31 base + AI components",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ui",
    "components",
    "ai",
    "copy-paste",
    "react",
    "react-components",
    "agent-ui",
    "tool-calling"
  ],
  "license": "MIT",
  "author": "Mayur Rawte",
  "homepage": "https://mcp-elements.wearesnx.studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcp-elements/ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mcp-elements/ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mcp-elements/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist"
  ]
}
